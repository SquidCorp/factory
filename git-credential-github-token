#!/usr/bin/env bash
# Git credential helper: supplies GITHUB_TOKEN without writing it to disk.
# https://git-scm.com/docs/git-credential
set -euo pipefail

case "${1:-}" in
  get)
    if [[ -z "${GITHUB_TOKEN:-}" ]]; then
      exit 0
    fi
    printf 'username=x-access-token\n'
    printf 'password=%s\n' "${GITHUB_TOKEN}"
    ;;
  store|erase)
    exit 0
    ;;
esac
