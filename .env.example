# Orca AppImage tag from https://github.com/stablyai/orca/releases
ORCA_VERSION=v1.4.244

# Address your local Orca client should dial. 127.0.0.1 is correct when
# pairing from the same Mac via published port 6768. Use a LAN or
# Tailscale IP (not 127.0.0.1) if the client is on another machine.
ORCA_PAIRING_ADDRESS=127.0.0.1

# Extra flags for `orca serve`, e.g. --mobile-pairing
ORCA_SERVE_ARGS=

# Pi OpenRouter auth. Prefer a key from https://openrouter.ai/keys
# rather than committing one. docker compose injects this as
# OPENROUTER_API_KEY; the entrypoint also writes ~/.pi/agent/auth.json.
OPENROUTER_API_KEY=
